#!/usr/bin/env bash
# Pre-push preflight gate.
#
# Verifies the COMMITTED state (HEAD) builds/boots — NOT your dirty working tree.
# A provider you forgot to `git add` (a migration parent, an exported function,
# a module) looks fine locally because the file is on disk, but is absent from
# the commit and breaks prod. To expose that, we stash your local SOURCE changes
# (tracked + untracked, but git-ignored paths like node_modules are never
# touched) so the tree momentarily matches HEAD, run the gate against the real
# installed deps in place, then restore your changes.
#
# NOTE: deliberately NOT a git-worktree + node_modules junction — cleanup of such
# a junction on Windows can delete the REAL node_modules. Stash-in-place is safe.
#
# Enable once per clone:  bash scripts/setup-hooks.sh   (sets core.hooksPath)
# Emergency bypass:        git push --no-verify   (or PREFLIGHT_SKIP=1 git push)
set -uo pipefail

[ -n "${PREFLIGHT_SKIP:-}" ] && { echo "preflight: skipped (PREFLIGHT_SKIP set)"; exit 0; }

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Anything actually being pushed? (stdin: <localref> <localsha> <remoteref> <remotesha>)
ZERO="0000000000000000000000000000000000000000"
pushing=0
while read -r _lref lsha _rref _rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue
  pushing=1
done
[ "$pushing" = 0 ] && exit 0   # delete-only push, nothing to check

[ -f scripts/ci/preflight.sh ] || { echo "preflight: no gate here — skipping."; exit 0; }

# Only stash the source trees the gate inspects — keeps the (huge, irrelevant)
# untracked stuff elsewhere out of it, and node_modules is .gitignored so `-u`
# never stashes (or deletes) it.
SCOPE="backend frontend scripts .github .githooks"
stashed=0
if [ -n "$(git status --porcelain -- $SCOPE 2>/dev/null)" ]; then
  if git stash push -u -q -m "preflight-$$" -- $SCOPE; then
    stashed=1
  else
    echo "preflight: could not stash local changes; aborting push. (bypass: --no-verify)"
    exit 1
  fi
fi
restore() { [ "$stashed" = 1 ] && git stash pop -q >/dev/null 2>&1 || true; }
trap restore EXIT

echo "preflight: checking committed tree (HEAD $(git rev-parse --short HEAD)) …"
bash scripts/ci/preflight.sh "$repo_root"
rc=$?
exit $rc
