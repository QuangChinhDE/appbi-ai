APPBI_BASE_URL=http://localhost:8000
APPBI_PAT=replace_me
APPBI_TIMEOUT_SECONDS=120
APPBI_VERIFY_TLS=false

# Tool surface. Default `all` = the whole journey (Source -> Dataset ->
# Data Model -> Workboard). Power users can shrink it; comma-combinable.
# Stages: discover | source | dataset | model | build | deliver
# APPBI_MCP_PROFILE=all

# Creating a Google Sheets source needs ONE of:
#   - a platform service account (share the sheet with its email), OR
#   - the PAT owner's Google account connected in AppBI Settings.
# Run check_google_data_access() to see which path is available.
