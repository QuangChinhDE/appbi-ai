# AppBI Workboard MCP — environment variables
# Copy this file to .env and fill in the values.

# Base URL of your AppBI backend (no trailing slash)
APPBI_BASE_URL=http://localhost:8000

# Personal Access Token (PAT) for authentication
# Generate from: AppBI > Settings > Personal Access Tokens
APPBI_PAT=your_token_here

# Optional: timeout in seconds (default 60)
APPBI_TIMEOUT_SECONDS=60

# Optional: log level for MCP server (DEBUG|INFO|WARNING)
APPBI_MCP_LOG_LEVEL=INFO
