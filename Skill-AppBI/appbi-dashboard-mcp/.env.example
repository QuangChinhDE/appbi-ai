# ----------------------------------------------------------------------------
# AppBI Orchestrator MCP — environment template
# Copy to `.env` and fill in your values, then `.\run-mcp.ps1` (Windows) or
# `./run-mcp.sh` (mac/linux).
# ----------------------------------------------------------------------------

# AppBI base URL. Examples:
#   Local dev backend: http://localhost:8000
#   Hosted instance:   https://bi.example.com
APPBI_BASE_URL=http://localhost:8000

# Personal Access Token. Required scopes for the full orchestration flow:
#   data_sources=edit
#   datasets=edit
#   dashboards=edit
# Generate from AppBI: Settings → Personal Access Tokens.
APPBI_PAT=appbi_pat_replace_me

# Default per-request timeout (seconds). The semantic query endpoint can be
# slow on big joins — bump this if you see timeouts.
APPBI_TIMEOUT_SECONDS=120

# Long-running endpoint cap (seconds). Currently unused but reserved.
APPBI_LONG_TIMEOUT_SECONDS=300

# Verify TLS on the AppBI endpoint. Set to false ONLY for local self-signed
# certificates. Leave true for any hosted instance.
APPBI_VERIFY_TLS=true

# MCP log level: DEBUG / INFO / WARNING / ERROR.
APPBI_MCP_LOG_LEVEL=INFO

# Tool surface profile. Controls which @mcp.tool() functions are exposed to
# Claude — reduces tool-schema tokens per request and helps Claude pick the
# right tool faster. Values:
#   all     — every tool registered (legacy behaviour, default if unset)
#   report  — minimum tools needed to create a first-time dashboard end-to-end
#             (Source read + Dataset bootstrap + Blueprint flow + Chart/Dashboard create)
#   dataset — full Source + Dataset CRUD (create/edit dataset workflow)
#   explore — full Semantic view/model/explore CRUD (create/edit explore workflow)
# You can also pass a comma list, e.g. APPBI_MCP_PROFILE=dataset,explore.
# Prefer the wrapper scripts: run-mcp-report.ps1 / run-mcp-dataset.ps1 / run-mcp-explore.ps1
# (or the .sh counterparts) which set this for you.
APPBI_MCP_PROFILE=all
