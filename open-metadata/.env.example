# ============================================================
# OpenMetadata deployment env — copy to open-metadata/.env
# (open-metadata/.env is GITIGNORED — never commit real secrets)
#
# The values below are PLACEHOLDERS. Generate real secrets with:
#   bash open-metadata/gen-secrets.sh
# which fills OM_DB_PASSWORD + OM_JWT_KEY_ID here and writes the RSA keypair
# into open-metadata/secrets/jwt/.
# ============================================================

# ── Image versions ─────────────────────────────────────────────────────────
# REQUIRED. The cloned source is 2.0.0-SNAPSHOT (dev) — DO NOT run SNAPSHOT in prod.
# Pin a STABLE release tag from https://github.com/open-metadata/OpenMetadata/releases
# (verify it exists:  docker manifest inspect docker.getcollate.io/openmetadata/server:<tag> )
# For prod, prefer pinning by digest after first pull.
OPENMETADATA_VERSION=1.7.6
# OpenSearch 2.x (OM supports 2.6+). Apache-2.0 licensed.
OPENSEARCH_VERSION=2.11.1

# ── Resource caps (stability — keep OM from starving the core) ───────────────
OM_HEAP_OPTS=-Xmx1G -Xms1G
OM_MEM_LIMIT=2g
OS_HEAP=1g
OS_MEM_LIMIT=1500m
OM_LOG_LEVEL=INFO

# ── OM database — INSIDE appbi-db, separate database ─────────────────────────
# appbi-db = the docker alias of the core Postgres. If the core uses an external
# managed Postgres, point OM_DB_HOST at it instead.
OM_DB_HOST=appbi-db
OM_DB_PORT=5432
OM_DB_NAME=openmetadata_db
OM_DB_USER=openmetadata_user
OM_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD     # gen-secrets.sh overwrites this

# ── Identity / JWT ───────────────────────────────────────────────────────────
OM_PRINCIPAL_DOMAIN=appbi.local
OM_ADMIN_PRINCIPALS=[admin]
OM_JWT_KEY_ID=CHANGE_ME_UUID                 # gen-secrets.sh overwrites this
