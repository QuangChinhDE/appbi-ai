# ======================================================================
# AppBI Google Login Preset
# ======================================================================
# Use this file when you want:
# - users to sign in with Google
# - optional per-user Google access for BigQuery / Google Sheets
#
# Quick start:
#   cp .env.google.example .env
#   # Fill in all CHANGE_ME values and Google client values below
#   docker compose up -d --build
#
# Notes:
# - AUTH_GOOGLE_CLIENT_ID and NEXT_PUBLIC_GOOGLE_CLIENT_ID must be the same.
# - This preset is ready for local HTTP testing on http://localhost:3000.
# - For HTTPS/domain deployment, change COOKIE_SECURE back to true.
# - AUTH_GOOGLE_CLIENT_SECRET and AUTH_GOOGLE_DATA_REDIRECT_URI are required
#   only when BigQuery / Google Sheets should use each user's own Google
#   account instead of a service account.


# 1. ENVIRONMENT MODE
# "production" validates required secrets.
# "dev" or "development" skips strict secret validation.
ENVIRONMENT=production


# 2. DATABASE [REQUIRED]
# Docker Compose builds DATABASE_URL from these values.
DB_USER=appbi
DB_PASSWORD=CHANGE_ME
DB_NAME=appbi


# 3. SECURITY [REQUIRED]
# Shared JWT signing secret for backend and frontend auth.
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Fernet key for datasource credential encryption.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=

# Local-ready default. Change back to true for HTTPS deployment.
COOKIE_SECURE=false

# Google-first authentication preset
AUTH_PASSWORD_LOGIN_ENABLED=false
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID_HERE
# Required for per-user BigQuery / Google Sheets OAuth.
AUTH_GOOGLE_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET_HERE
# Exact callback URI registered in Google Cloud Console.
# Example local value:
#   http://localhost:3000/api/v1/auth/google/data-access/callback
AUTH_GOOGLE_DATA_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/data-access/callback
# Optional comma-separated allowlist such as: yourcompany.com,subsidiary.com
AUTH_GOOGLE_ALLOWED_DOMAINS=
# false = admin pre-creates users and assigns roles
# true  = first Google sign-in auto-creates an active user
AUTH_GOOGLE_AUTO_CREATE_USERS=false
# Optional one-time bootstrap admin for Google login.
# If this email signs in with Google before being created in AppBI,
# AppBI will auto-create it with full admin permissions.
AUTH_GOOGLE_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID_HERE


# 4. ADMIN ACCOUNT [REQUIRED]
# Created automatically on first boot if no users exist.
ADMIN_EMAIL=admin@appbi.io
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin


# 5. DOMAIN / URLS
# Baked into Next.js at build time. Relative path works behind nginx too.
NEXT_PUBLIC_API_URL=/api/v1

# Comma-separated allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenRouter request metadata
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AppBI

# Live-query-first mode
ENABLE_DATASOURCE_SYNC=false
NEXT_PUBLIC_ENABLE_DATASOURCE_SYNC=false
BQ_MAX_BYTES_SCANNED=64424509440
BQ_PREVIEW_PARTITION_MAX_LOOKBACK_DAYS=365


# 5b. SMTP (Dataset Quality scheduled email reports)
# Quick preset below is for Gmail / Google Workspace SMTP.
# If you use another provider, replace SMTP_HOST / PORT / TLS settings.
# When SMTP_HOST is empty, scheduled quality runs still execute but email
# delivery is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AppBI Quality


# 6. HOST PORT MAPPING
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_CHAT_PORT=8001
AI_AGENT_PORT=8002


# 7. DEMO DATA
SEED_DEMO_DATA=false


# 8. LOGGING
LOG_LEVEL=INFO


# 9. OPENROUTER API KEYS [REQUIRED FOR AI]
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=


# 10. LLM MODELS - GENERIC
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_CHAIN=
LLM_TIMEOUT_SECONDS=60


# 11. LLM MODELS - AI CHAT
AI_CHAT_MODEL=
AI_CHAT_FALLBACK_MODELS=


# 12. LLM MODELS - AI AGENT
AI_AGENT_MODEL=
AI_AGENT_LLM_MODEL=
AI_AGENT_ENRICHMENT_MODEL=
AI_AGENT_PLANNING_MODEL=
AI_AGENT_INSIGHT_MODEL=
AI_AGENT_NARRATIVE_MODEL=
AI_AGENT_FALLBACK_MODELS=
AI_AGENT_LLM_FALLBACK_CHAIN=
AI_AGENT_LLM_TIMEOUT_SECONDS=0


# 13. LLM MODELS - BACKEND AI FEATURES
AI_DESCRIPTION_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=768


# 14. AI CHAT SESSION TUNING
AI_SESSION_TTL_MINUTES=30
AI_MAX_TOOL_CALLS=8
AI_DATASET_TABLE_LIMIT=50


# 15. GCP SERVICE ACCOUNT (OPTIONAL)
# If set, users can still use a shared service account instead of personal OAuth.
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_JSON=


# 16. FRONTEND AI SERVICE OVERRIDES (OPTIONAL)
# Set only if AI services live on another host.
# NEXT_PUBLIC_AI_CHAT_WS_URL=wss://other-ai-host.com/chat/ws
# NEXT_PUBLIC_AI_CHAT_HTTP_URL=https://other-ai-host.com
# NEXT_PUBLIC_AI_AGENT_HTTP_URL=https://other-ai-host.com


# 17. NGINX / DOMAIN DEPLOYMENT NOTES
# When deploying on a real domain with HTTPS:
# - set COOKIE_SECURE=true
# - change CORS_ORIGINS to your real domain
# - change AUTH_GOOGLE_DATA_REDIRECT_URI to your real callback URL
