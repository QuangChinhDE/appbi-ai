{
  "about": "Persisted SemanticExplore.joins rows in the forms written before 22bac47f (and a few that were never valid). Base view of every row: 'orders'. Each case states how the relationship contract (semantic_join_resolver.read_join_contract) must classify it. SUPPORTED = a deterministic canonical reading; INVALID = refused loudly (never defaulted). No case is MIGRATED: lazy canonicalization at read is the strategy — every row in the real database at audit time (336) reads as SUPPORTED.",
  "cases": [
    {"id": "relationship_only", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "sql_on": "${TABLE}.customer_id = ${customers}.id", "relationship": "many_to_one"},
     "expect": {"cardinality": "many_to_one", "is_active": true, "cross_filter": "single", "key_pairs": [["customer_id", "id"]]}},
    {"id": "short_alias_n1", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "relationship": "N:1"},
     "expect": {"cardinality": "many_to_one"}},
    {"id": "short_alias_1n_reverse_authored", "class": "SUPPORTED",
     "join": {"view": "returns", "from_column": "id", "to_column": "order_id", "relationship": "1:N"},
     "expect": {"cardinality": "one_to_many"}},
    {"id": "missing_is_active_and_cross_filter", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "relationship": "many_to_one"},
     "expect": {"is_active": true, "cross_filter": "single"}},
    {"id": "string_false", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "is_active": "false"},
     "expect": {"is_active": false}},
    {"id": "string_true_uppercase", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "is_active": "TRUE"},
     "expect": {"is_active": true}},
    {"id": "int_zero", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "is_active": 0},
     "expect": {"is_active": false}},
    {"id": "cross_filter_mixed_case", "class": "SUPPORTED",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "cross_filter": "Both"},
     "expect": {"cross_filter": "both"}},
    {"id": "lookml_condition_no_columns", "class": "SUPPORTED",
     "join": {"view": "customers", "sql_on": "${orders.customer_id} = ${customers.id}", "relationship": "many_to_one"},
     "expect": {"key_pairs": [["customer_id", "id"]]}},
    {"id": "reversed_equality", "class": "SUPPORTED",
     "join": {"view": "customers", "sql_on": "${customers}.id = ${TABLE}.customer_id", "cardinality": "many_to_one"},
     "expect": {"key_pairs": [["customer_id", "id"]]}},
    {"id": "composite_sql_on_scalar_first_pair", "class": "SUPPORTED",
     "join": {"view": "shops", "from_column": "region_code", "to_column": "region_code", "sql_on": "${TABLE}.region_code = ${shops}.region_code AND ${TABLE}.store_code = ${shops}.store_code", "cardinality": "many_to_one"},
     "expect": {"key_pairs": [["region_code", "region_code"], ["store_code", "store_code"]]}},
    {"id": "composite_lists", "class": "SUPPORTED",
     "join": {"view": "shops", "from_columns": ["region_code", "store_code"], "to_columns": ["region_code", "store_code"], "from_column": "region_code", "to_column": "region_code", "cardinality": "many_to_one"},
     "expect": {"key_pairs": [["region_code", "region_code"], ["store_code", "store_code"]]}},
    {"id": "calendar_cast_expression", "class": "SUPPORTED",
     "join": {"view": "orders__created_at__date_dim", "from_column": "created_at", "to_column": "date", "from_columns": ["created_at"], "to_columns": ["date"], "sql_on": "CAST(${TABLE}.created_at AS DATE) = ${orders__created_at__date_dim}.date", "relationship": "many_to_one", "origin": "auto_calendar", "managed": true},
     "expect": {"key_source": "expression", "key_pairs": [["created_at", "date"]]}},
    {"id": "role_played_alias_ship", "class": "SUPPORTED",
     "join": {"view": "calendar", "alias": "ship_cal", "from_column": "ship_date", "to_column": "date", "sql_on": "${TABLE}.ship_date = ${ship_cal}.date", "cardinality": "many_to_one"},
     "expect": {"node": "ship_cal"}},
    {"id": "role_played_alias_close", "class": "SUPPORTED",
     "join": {"view": "calendar", "alias": "close_cal", "from_column": "close_date", "to_column": "date", "sql_on": "${TABLE}.close_date = ${close_cal}.date", "cardinality": "many_to_one"},
     "expect": {"node": "close_cal"}},
    {"id": "self_join_alias", "class": "SUPPORTED",
     "join": {"view": "orders", "alias": "parent_order", "sql_on": "${TABLE}.parent_id = ${orders}.id", "cardinality": "many_to_one"},
     "expect": {"node": "parent_order", "key_pairs": [["parent_id", "id"]]}},
    {"id": "expression_columns_disagree", "class": "INVALID",
     "join": {"view": "orders__created_at__date_dim", "from_columns": ["created_at"], "to_columns": ["id"], "sql_on": "CAST(${TABLE}.created_at AS DATE) = ${orders__created_at__date_dim}.date", "relationship": "many_to_one"}},
    {"id": "missing_cardinality_and_relationship", "class": "INVALID",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id"}},
    {"id": "unknown_cardinality", "class": "INVALID",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "bogus"}},
    {"id": "conflicting_cardinality", "class": "INVALID",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "relationship": "one_to_many"}},
    {"id": "is_active_garbage", "class": "INVALID",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "is_active": "no"}},
    {"id": "invalid_cross_filter", "class": "INVALID",
     "join": {"view": "customers", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one", "cross_filter": "bidirectional"}},
    {"id": "composite_lists_disagree_with_sql_on", "class": "INVALID",
     "join": {"view": "shops", "from_columns": ["region_code"], "to_columns": ["region_code"], "sql_on": "${TABLE}.region_code = ${shops}.region_code AND ${TABLE}.store_code = ${shops}.store_code", "cardinality": "many_to_one"}},
    {"id": "expression_without_key_columns", "class": "INVALID",
     "join": {"view": "orders__created_at__date_dim", "sql_on": "CAST(${TABLE}.created_at AS DATE) = ${orders__created_at__date_dim}.date", "relationship": "many_to_one"}},
    {"id": "sql_on_names_a_third_table", "class": "INVALID",
     "join": {"view": "customers", "sql_on": "${TABLE}.customer_id = ${stores}.id", "cardinality": "many_to_one"}},
    {"id": "from_view_of_another_explore", "class": "INVALID",
     "join": {"view": "customers", "from_view": "returns", "from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one"}},
    {"id": "no_condition", "class": "INVALID",
     "join": {"view": "customers", "cardinality": "many_to_one"}},
    {"id": "missing_view", "class": "INVALID",
     "join": {"from_column": "customer_id", "to_column": "id", "cardinality": "many_to_one"}}
  ]
}
