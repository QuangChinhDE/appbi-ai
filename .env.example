# Copy to .env and replace CHANGE_ME before production. Do not commit .env.

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database (use DATABASE_URL for managed PG, else DB_*) ---
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/appbi?sslmode=require
DATABASE_URL=
DB_HOST=appbi-db
DB_PORT=5432
DB_USER=appbi
DB_PASSWORD=CHANGE_ME
DB_NAME=appbi

# --- Security ---
# SECRET_KEY:                python -c "import secrets; print(secrets.token_urlsafe(64))"
# DATASOURCE_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME
DATASOURCE_ENCRYPTION_KEY=
COOKIE_SECURE=true

# --- First admin ---
ADMIN_EMAIL=admin@appbi.io
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin

# --- URLs / ports ---
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Auth ---
AUTH_PASSWORD_LOGIN_ENABLED=true
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_DATA_REDIRECT_URI=
AUTH_GOOGLE_ALLOWED_DOMAINS=
AUTH_GOOGLE_AUTO_CREATE_USERS=false
AUTH_GOOGLE_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Feature flags ---
WORKBOARDS_ENABLED=true
NEXT_PUBLIC_WORKBOARDS_ENABLED=true
ENABLE_DATASOURCE_SYNC=false
NEXT_PUBLIC_ENABLE_DATASOURCE_SYNC=false
SEED_DEMO_DATA=false

# --- Metadata Catalog / Governance (DB-backed) ---
# Modules are ON by default; `run` force-enables them (see scripts/bootstrap-env.sh).
METADATA_CATALOG_ENABLED=true

# --- Query & cache limits ---
BQ_MAX_BYTES_SCANNED=64424509440
BQ_PREVIEW_PARTITION_MAX_LOOKBACK_DAYS=365
# ─── Snapshot materialization (Dashboard perf #5) ─────────────────────────────
# Pre-computes heavy dataset tables into flat BigQuery "snapshot" tables so
# dashboards load fast. OPT-IN per datasource (set materialization_enabled on the
# datasource). Data flow: the connected datasource account EXTRACTS source rows
# (read-only); the WRITE SERVICE ACCOUNT below CREATES + LOADS the snapshot tables
# (it never reads your source). Charts then read the snapshots via that same SA.
#
# 1) Snapshot dataset — a dedicated BQ dataset, created in the SAME project as the
#    datasource's source tables. Intended to be accessible ONLY by the write SA.
MATERIALIZATION_DATASET=appbi_snapshots
#
# 2) Write service account (AppBI-owned) — CREATES + LOADS snapshot tables. Grant
#    it "BigQuery Data Editor" on the snapshot dataset ONLY (it needs NO access to
#    your source data). Provide its key ONE of two ways (KEY_FILE takes priority):
#      • MATERIALIZATION_SA_KEY_FILE      = absolute path to the SA JSON key file
#      • MATERIALIZATION_SA_CREDENTIALS_JSON = the SA key JSON inline (single line)
#    Leave BOTH blank to fall back to the datasource's own credential (only works
#    if that credential can write the snapshot dataset — not the SA-isolation model).
MATERIALIZATION_SA_KEY_FILE=
MATERIALIZATION_SA_CREDENTIALS_JSON=
#
# 3) Default snapshot freshness TTL (minutes) — fallback for builder/public links.
MATERIALIZATION_DEFAULT_TTL_MINUTES=30
LIVE_QUERY_CACHE_TTL=300
LIVE_QUERY_CACHE_MAX_SIZE=256
LIVE_QUERY_SHARED_CACHE_ENABLED=true
LIVE_QUERY_SHARED_CACHE_DB_PATH=
LIVE_QUERY_SHARED_CACHE_MAX_SIZE=4096
LARGE_TABLE_ROW_THRESHOLD=50000000
LARGE_TABLE_SIZE_THRESHOLD_GB=5

# --- SMTP (leave SMTP_HOST blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AppBI Quality
SMTP_TIMEOUT_SECONDS=20

# --- GCP service account ---
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_JSON=

# AI provider keys (backend AI + report AI bot). Models are fixed in code.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
