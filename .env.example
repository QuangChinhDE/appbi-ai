# Copy to .env and replace CHANGE_ME before production. Do not commit .env.

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database (use DATABASE_URL for managed PG, else DB_*) ---
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/appbi?sslmode=require
DATABASE_URL=
DB_HOST=appbi-db
DB_PORT=5432
DB_USER=appbi
DB_PASSWORD=CHANGE_ME
DB_NAME=appbi

# --- Security ---
# SECRET_KEY:                python -c "import secrets; print(secrets.token_urlsafe(64))"
# DATASOURCE_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME
DATASOURCE_ENCRYPTION_KEY=
COOKIE_SECURE=true

# --- First admin ---
ADMIN_EMAIL=admin@appbi.io
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin

# --- URLs / ports ---
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Auth ---
AUTH_PASSWORD_LOGIN_ENABLED=true
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_DATA_REDIRECT_URI=
AUTH_GOOGLE_ALLOWED_DOMAINS=
AUTH_GOOGLE_AUTO_CREATE_USERS=false
AUTH_GOOGLE_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Feature flags ---
WORKBOARDS_ENABLED=true
NEXT_PUBLIC_WORKBOARDS_ENABLED=true
ENABLE_DATASOURCE_SYNC=false
NEXT_PUBLIC_ENABLE_DATASOURCE_SYNC=false
SEED_DEMO_DATA=false

# --- Metadata Catalog (hidden OpenMetadata backend) ---
# Default OFF → the catalog module is fully INERT; the core app boots & behaves
# exactly as today even if the OM stack / module is absent. To enable:
#   1) bring up OM:  bash scripts/catalog-up.sh   (wraps open-metadata/README.md)
#   2) once OM is healthy, fetch the ingestion-bot JWT and set it below
#   3) set METADATA_CATALOG_ENABLED=true and rebuild the backend
# WARNING: do NOT set =true while the OM server is unreachable — /api/v1/catalog/*
# will 502 (the rest of the app is unaffected, but the catalog pages error).
METADATA_CATALOG_ENABLED=false
OPENMETADATA_API_URL=http://openmetadata-server:8585/api
OPENMETADATA_BOT_TOKEN=

# --- Query & cache limits ---
BQ_MAX_BYTES_SCANNED=64424509440
BQ_PREVIEW_PARTITION_MAX_LOOKBACK_DAYS=365
LIVE_QUERY_CACHE_TTL=300
LIVE_QUERY_CACHE_MAX_SIZE=256
LIVE_QUERY_SHARED_CACHE_ENABLED=true
LIVE_QUERY_SHARED_CACHE_DB_PATH=
LIVE_QUERY_SHARED_CACHE_MAX_SIZE=4096
LARGE_TABLE_ROW_THRESHOLD=50000000
LARGE_TABLE_SIZE_THRESHOLD_GB=5

# --- SMTP (leave SMTP_HOST blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AppBI Quality
SMTP_TIMEOUT_SECONDS=20

# --- GCP service account ---
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_JSON=

# --- AI providers (blank = disabled) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AppBI

# --- AI models ---
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_FALLBACK_CHAIN=
LLM_TIMEOUT_SECONDS=60

AI_DESCRIPTION_MODEL=google/gemini-2.5-flash-lite
GEMINI_IMPORT_MODEL=gemini-2.5-flash-lite
GEMINI_QUALITY_MODEL=
OPENROUTER_GEMINI_IMPORT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=768

BACKEND_AI_DEFAULT_MODEL=google/gemini-2.5-flash-lite
BACKEND_AI_DATASET_DOCS_MODEL=
BACKEND_AI_CHART_DOCS_MODEL=
BACKEND_AI_QUALITY_RULE_GEMINI_MODEL=
BACKEND_AI_QUALITY_RULE_OPENROUTER_MODEL=
BACKEND_AI_HTML_IMPORT_GEMINI_MODEL=
BACKEND_AI_HTML_IMPORT_OPENROUTER_MODEL=
BACKEND_AI_EMBEDDING_MODEL=

GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_BALANCED_MODEL=gemini-2.5-flash-lite
GEMINI_INSIGHT_MODEL=gemini-2.5-flash
GEMINI_EXPLORE_MODEL=
GEMINI_CREATE_MODEL=
