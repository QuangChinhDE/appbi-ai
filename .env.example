# ╔══════════════════════════════════════════════════════════════╗
# ║  AppBI — Unified Environment Configuration                 ║
# ║                                                            ║
# ║  This single file defines ALL variables for every service: ║
# ║    • db (PostgreSQL)                                       ║
# ║    • backend (Python/FastAPI)                               ║
# ║    • frontend (Next.js)                                     ║
# ║    • ai-chat-service (AI Chat)                              ║
# ║    • ai-agent-service (AI Agent)                            ║
# ║                                                            ║
# ║  Quick start:                                               ║
# ║    Basic/password login: cp .env.example .env               ║
# ║    Google login:         cp .env.google.example .env        ║
# ║    # Fill in all CHANGE_ME values                           ║
# ║    docker compose up -d --build                             ║
# ║                                                            ║
# ║  With AI services:                                          ║
# ║    docker compose -f docker-compose.yml \                   ║
# ║      -f docker-compose.ai.yml up -d --build                ║
# ║                                                            ║
# ║  Stack variants:                                            ║
# ║    Base BI only:  docker compose up -d --build              ║
# ║    + Both AI:     ... -f docker-compose.ai.yml ...          ║
# ║    + Agent only:  ... -f docker-compose.agent.yml ...       ║
# ║    + Chat only:   ... -f docker-compose.chat.yml ...        ║
# ║    Dev hot-reload: docker compose -f docker-compose.dev.yml ║
# ║                    up --build -d                            ║
# ╚══════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────┐
# │  1. ENVIRONMENT MODE                                         │
# │  Used by: backend, ai-chat-service, ai-agent-service         │
# └──────────────────────────────────────────────────────────────┘
# "production" (default) — enforces SECRET_KEY and ENCRYPTION_KEY validation.
# "dev" or "development" — skips secret validation, uses insecure defaults.
ENVIRONMENT=production


# ┌──────────────────────────────────────────────────────────────┐
# │  2. DATABASE                                     [REQUIRED]  │
# │  Used by: db container, backend (via DATABASE_URL)           │
# └──────────────────────────────────────────────────────────────┘
# Docker Compose automatically builds DATABASE_URL from these three values.
# You do NOT need to set DATABASE_URL separately.
DB_USER=appbi
DB_PASSWORD=CHANGE_ME
DB_NAME=appbi


# ┌──────────────────────────────────────────────────────────────┐
# │  3. SECURITY                                     [REQUIRED]  │
# │  Used by: backend, frontend, ai-chat-service, ai-agent       │
# └──────────────────────────────────────────────────────────────┘
# Random string for JWT signing — ALL services must share the same value.
# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Fernet key for encrypting datasource credentials at rest.
# Required in production for PostgreSQL, MySQL, BigQuery, Google Sheets sources.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=

# Cookie secure flag. Set to "false" only for local HTTP development (no HTTPS).
COOKIE_SECURE=true

# Authentication mode
# Basic/default preset:
# - email/password login enabled
# - Google sign-in disabled
# Copy .env.google.example instead if you want Google-first login.
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
# Required only if users should connect BigQuery / Google Sheets with their
# own Google account (instead of service accounts).
AUTH_GOOGLE_CLIENT_SECRET=
# Exact callback URI registered in Google Cloud Console, for example:
#   http://localhost:3000/api/v1/auth/google/data-access/callback
#   https://bi.example.com/api/v1/auth/google/data-access/callback
AUTH_GOOGLE_DATA_REDIRECT_URI=
# Optional comma-separated allowlist such as: yourcompany.com,subsidiary.com
AUTH_GOOGLE_ALLOWED_DOMAINS=
# false = only pre-created users can sign in with Google
# true  = first Google sign-in auto-creates a new active user
AUTH_GOOGLE_AUTO_CREATE_USERS=false
# Optional one-time bootstrap admin for Google login.
# If this email signs in with Google before being created in AppBI,
# AppBI will auto-create it with full admin permissions.
AUTH_GOOGLE_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN_ENABLED=true
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ┌──────────────────────────────────────────────────────────────┐
# │  4. ADMIN ACCOUNT                               [REQUIRED]  │
# │  Used by: backend (first-boot seed)                          │
# └──────────────────────────────────────────────────────────────┘
# Created automatically on first boot if no users exist.
ADMIN_EMAIL=admin@appbi.io
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin


# ┌──────────────────────────────────────────────────────────────┐
# │  5. DOMAIN / URLS                                            │
# │  Used by: frontend (build-time), backend, AI services        │
# └──────────────────────────────────────────────────────────────┘
# Baked into Next.js bundle at BUILD TIME. Relative path works on any domain.
NEXT_PUBLIC_API_URL=/api/v1

# Allow requests from these origins (comma-separated).
# For domain deployment, add your domain:
#   CORS_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Live-query-first mode:
# false = hide/disable datasource sync and query datasets directly from the source
ENABLE_DATASOURCE_SYNC=false
NEXT_PUBLIC_ENABLE_DATASOURCE_SYNC=false
BQ_MAX_BYTES_SCANNED=64424509440
BQ_PREVIEW_PARTITION_MAX_LOOKBACK_DAYS=365


# ┌──────────────────────────────────────────────────────────────┐
# │  5b. SMTP (Dataset Quality scheduled email reports)          │
# │  Used by: backend                                            │
# └──────────────────────────────────────────────────────────────┘
# Quick preset below is for Gmail / Google Workspace SMTP.
# If you use another provider, replace SMTP_HOST / PORT / TLS settings.
# When SMTP_HOST is empty, scheduled quality runs still execute but the
# PDF report email is skipped (with a log warning).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AppBI Quality


# ┌──────────────────────────────────────────────────────────────┐
# │  6. HOST PORT MAPPING                                        │
# │  Used by: docker-compose port bindings                       │
# └──────────────────────────────────────────────────────────────┘
# Change if these ports are already in use on your host.
# When using nginx reverse proxy, these are internal only.
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_CHAT_PORT=8001
AI_AGENT_PORT=8002


# ┌──────────────────────────────────────────────────────────────┐
# │  7. DEMO DATA                                                │
# │  Used by: backend                                            │
# └──────────────────────────────────────────────────────────────┘
# Set to "true" to auto-load a Football/FIFA demo dataset on first boot.
# Creates admin/edit/viewer accounts + datasource + datasets + charts + dashboards.
SEED_DEMO_DATA=false


# ┌──────────────────────────────────────────────────────────────┐
# │  8. LOGGING                                                  │
# │  Used by: backend, ai-chat-service, ai-agent-service         │
# └──────────────────────────────────────────────────────────────┘
LOG_LEVEL=INFO


# ╔══════════════════════════════════════════════════════════════╗
# ║  9. AI CONFIGURATION — MODULE → KEY REFERENCE               ║
# ║                                                             ║
# ║  Which module needs which API key:                          ║
# ║                                                             ║
# ║  GEMINI_API_KEY ──────┬── ai-chat   (primary provider)     ║
# ║                       └── backend   (quality, import)       ║
# ║                                                             ║
# ║  OPENROUTER_API_KEY ──┬── ai-report (sole provider)        ║
# ║                       ├── backend   (docs, embed, import)  ║
# ║                       └── ai-chat   (fallback only)        ║
# ║                                                             ║
# ║  Which module reads which model vars:                       ║
# ║                                                             ║
# ║  ai-chat  ─── AI_CHAT_*_MODEL           → §11              ║
# ║  ai-report ── AI_REPORT_*_MODEL         → §12              ║
# ║  backend  ─── BACKEND_AI_*_MODEL        → §13              ║
# ║                                                             ║
# ║  Fallback: capability → module default → global default     ║
# ╚══════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────┐
# │  9a. GEMINI DIRECT API KEY                   [REQUIRED]      │
# │  Read by: ai-chat (primary), backend (quality, import)       │
# └──────────────────────────────────────────────────────────────┘
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME


# ┌──────────────────────────────────────────────────────────────┐
# │  9b. OPENROUTER API KEYS                    [REQUIRED]       │
# │  Read by: ai-report (all phases), backend (docs, embed),    │
# │           ai-chat (fallback when GEMINI_API_KEY is empty)    │
# └──────────────────────────────────────────────────────────────┘
# Keys are tried in order 1→2→3→4→5, then bare OPENROUTER_API_KEY.
# On quota/auth error (401/402/403/429) the next key is auto-rotated.
# Get your keys at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
# OpenRouter request metadata (appears in HTTP headers for analytics).
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AppBI


# ┌──────────────────────────────────────────────────────────────┐
# │  10. GLOBAL AI DEFAULTS                                      │
# │  Read by: ai-chat (fallback), ai-report (fallback)          │
# └──────────────────────────────────────────────────────────────┘
# Final fallback model when a module-specific var is blank.
#
# Model cheat-sheet:
#   Gemini Direct : gemini-3-flash-preview │ gemini-2.5-flash │ gemini-2.5-pro
#   OpenRouter    : google/gemini-3-flash-preview │ google/gemini-2.5-flash │ google/gemini-2.5-pro
#   Embedding     : openai/text-embedding-3-small │ openai/text-embedding-3-large
LLM_MODEL=google/gemini-3-flash-preview
LLM_FALLBACK_CHAIN=
LLM_TIMEOUT_SECONDS=60


# ┌──────────────────────────────────────────────────────────────┐
# │  11. AI-CHAT MODULE                                          │
# │  Read by: ai-chat-service ONLY                               │
# │  Provider: Gemini Direct (primary), OpenRouter (fallback)    │
# │  API key: GEMINI_API_KEY                                     │
# │                                                              │
# │  All env vars this module reads:                             │
# │    Models ── AI_CHAT_DEFAULT_MODEL                           │
# │              AI_CHAT_INTENT_CLASSIFIER_MODEL                 │
# │              AI_CHAT_LOOKUP_MODEL                            │
# │              AI_CHAT_EXPLORE_MODEL                           │
# │              AI_CHAT_CREATE_MODEL                            │
# │              AI_CHAT_INSIGHT_PLANNING_MODEL                  │
# │              AI_CHAT_INSIGHT_EXECUTION_MODEL                 │
# │              AI_CHAT_SUGGESTION_MODEL                        │
# │    Fallback─ AI_CHAT_FALLBACK_MODELS                        │
# │    Tuning ── AI_SESSION_TTL_MINUTES                          │
# │              AI_MAX_TOOL_CALLS                               │
# │              AI_DATASET_TABLE_LIMIT                          │
# └──────────────────────────────────────────────────────────────┘
# IMPORTANT: When GEMINI_API_KEY is set → use Gemini IDs (gemini-3-flash-preview).
#            When GEMINI_API_KEY is empty → use OpenRouter IDs (google/gemini-3-flash-preview).
#
# ── Models ─────────────────────────────────────────────────────
# Module-wide default for chat turns when a specific capability is blank.
AI_CHAT_DEFAULT_MODEL=gemini-3-flash-preview
# Intent classifier before routing to LOOKUP / EXPLORE / INSIGHT / CREATE.
AI_CHAT_INTENT_CLASSIFIER_MODEL=gemini-3-flash-preview
# LOOKUP: precise retrieval, filters, rankings, counts.
AI_CHAT_LOOKUP_MODEL=gemini-3-flash-preview
# EXPLORE: schema discovery, profiling, overview of available data.
AI_CHAT_EXPLORE_MODEL=gemini-3-flash-preview
# CREATE: create chart / dashboard from the conversation.
AI_CHAT_CREATE_MODEL=gemini-3-flash-preview
# INSIGHT phase A: build the investigation plan before tool execution.
AI_CHAT_INSIGHT_PLANNING_MODEL=gemini-2.5-flash
# INSIGHT phase B: execute deep analysis and synthesize the answer.
AI_CHAT_INSIGHT_EXECUTION_MODEL=gemini-2.5-flash
# Follow-up suggestions after the final answer.
AI_CHAT_SUGGESTION_MODEL=gemini-3-flash-preview
# ── Fallback ───────────────────────────────────────────────────
# Ordered fallback models if the primary chat model fails.
AI_CHAT_FALLBACK_MODELS=
# ── Tuning ─────────────────────────────────────────────────────
AI_SESSION_TTL_MINUTES=30
AI_MAX_TOOL_CALLS=8
AI_DATASET_TABLE_LIMIT=50


# ┌──────────────────────────────────────────────────────────────┐
# │  12. AI-REPORT MODULE                                        │
# │  Read by: ai-agent-service (ai-report) ONLY                 │
# │  Provider: OpenRouter only                                   │
# │  API key: OPENROUTER_API_KEY_*                               │
# │                                                              │
# │  All env vars this module reads:                             │
# │    Models ── AI_REPORT_DEFAULT_MODEL                         │
# │              AI_REPORT_BRIEF_ENRICHMENT_MODEL                │
# │              AI_REPORT_ANALYSIS_PLANNING_MODEL               │
# │              AI_REPORT_INSIGHT_GENERATION_MODEL              │
# │              AI_REPORT_NARRATIVE_SYNTHESIS_MODEL              │
# │              AI_REPORT_SUMMARY_READER_MODEL                  │
# │    Fallback─ AI_REPORT_FALLBACK_MODELS                      │
# │              AI_REPORT_LLM_FALLBACK_CHAIN                   │
# │    Tuning ── AI_REPORT_TIMEOUT_SECONDS                       │
# └──────────────────────────────────────────────────────────────┘
# ── Models ─────────────────────────────────────────────────────
# Module-wide default for report generation.
AI_REPORT_DEFAULT_MODEL=google/gemini-3-flash-preview
# Enrich raw brief with domain context, KPIs, business questions.
AI_REPORT_BRIEF_ENRICHMENT_MODEL=google/gemini-3-flash-preview
# Build analysis plan, hypotheses, chart specs, reading order.
AI_REPORT_ANALYSIS_PLANNING_MODEL=google/gemini-3-flash-preview
# Generate chart-level and section-level insights from built outputs.
AI_REPORT_INSIGHT_GENERATION_MODEL=google/gemini-3-flash-preview
# Compose final executive narrative / dashboard readout.
AI_REPORT_NARRATIVE_SYNTHESIS_MODEL=google/gemini-3-flash-preview
# Reserved: dedicated AI for reading completed reports and writing summaries.
AI_REPORT_SUMMARY_READER_MODEL=
# ── Fallback ───────────────────────────────────────────────────
AI_REPORT_FALLBACK_MODELS=
AI_REPORT_LLM_FALLBACK_CHAIN=
# ── Tuning ─────────────────────────────────────────────────────
AI_REPORT_TIMEOUT_SECONDS=0


# ┌──────────────────────────────────────────────────────────────┐
# │  13. BACKEND AI MODULE                                       │
# │  Read by: backend ONLY                                       │
# │  Provider: Gemini Direct + OpenRouter (depends on feature)   │
# │  API keys: GEMINI_API_KEY + OPENROUTER_API_KEY_*             │
# │                                                              │
# │  All env vars this module reads:                             │
# │    Models ── BACKEND_AI_DEFAULT_MODEL            (OR)        │
# │              BACKEND_AI_DATASET_DOCS_MODEL       (OR)        │
# │              BACKEND_AI_CHART_DOCS_MODEL         (OR)        │
# │              BACKEND_AI_QUALITY_RULE_GEMINI_MODEL  (Gemini)  │
# │              BACKEND_AI_QUALITY_RULE_OPENROUTER_MODEL  (OR)  │
# │              BACKEND_AI_TEMPLATE_IMPORT_GEMINI_MODEL(Gemini) │
# │              BACKEND_AI_TEMPLATE_IMPORT_OPENROUTER_MODEL(OR) │
# │              BACKEND_AI_EMBEDDING_MODEL          (OR)        │
# │              BACKEND_AI_REPORT_SUMMARY_MODEL                 │
# │    Tuning ── OPENROUTER_EMBEDDING_DIMENSIONS                 │
# └──────────────────────────────────────────────────────────────┘
# ── Models ─────────────────────────────────────────────────────
# Module-wide OpenRouter default for backend text-generation tasks.
BACKEND_AI_DEFAULT_MODEL=google/gemini-3-flash-preview
# Dataset docs: table description + column descriptions + common questions.
BACKEND_AI_DATASET_DOCS_MODEL=google/gemini-3-flash-preview
# Chart docs: chart description + tags + insight keywords.
BACKEND_AI_CHART_DOCS_MODEL=google/gemini-3-flash-preview
# Quality rule suggestion via Gemini direct.
BACKEND_AI_QUALITY_RULE_GEMINI_MODEL=gemini-3-flash-preview
# Quality rule suggestion via OpenRouter fallback.
BACKEND_AI_QUALITY_RULE_OPENROUTER_MODEL=google/gemini-3-flash-preview
# Template / report import via Gemini direct.
BACKEND_AI_TEMPLATE_IMPORT_GEMINI_MODEL=gemini-3-flash-preview
# Template / report import via OpenRouter.
BACKEND_AI_TEMPLATE_IMPORT_OPENROUTER_MODEL=google/gemini-3-flash-preview
# Semantic search embeddings for datasets / charts.
BACKEND_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Reserved: backend-side AI summary for imported/generated reports.
BACKEND_AI_REPORT_SUMMARY_MODEL=
# ── Tuning ─────────────────────────────────────────────────────
OPENROUTER_EMBEDDING_DIMENSIONS=768


# ┌──────────────────────────────────────────────────────────────┐
# │  14. GCP SERVICE ACCOUNT (optional)                          │
# │  Used by: backend                                            │
# └──────────────────────────────────────────────────────────────┘
# When set, users connecting Google Sheets or BigQuery do NOT need to upload
# a credentials JSON — they only need to share their resource with this email.
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_JSON=


# ┌──────────────────────────────────────────────────────────────┐
# │  15. FRONTEND AI SERVICE OVERRIDES (rarely needed)           │
# │  Used by: frontend (client-side, browser)                    │
# └──────────────────────────────────────────────────────────────┘
# AI service URLs are auto-detected from window.location in the browser.
# You do NOT need these if AI services run behind the same nginx as the frontend.
# Only set these if AI services run on a DIFFERENT host entirely.
# NEXT_PUBLIC_AI_CHAT_WS_URL=wss://other-ai-host.com/chat/ws
# NEXT_PUBLIC_AI_CHAT_HTTP_URL=https://other-ai-host.com
# NEXT_PUBLIC_AI_AGENT_HTTP_URL=https://other-ai-host.com


# ┌──────────────────────────────────────────────────────────────┐
# │  16. NGINX (domain deployment notes)                         │
# └──────────────────────────────────────────────────────────────┘
# See nginx.conf in the repo root for the complete ready-to-use config.
#
# Quick setup:
#   sudo apt install -y nginx certbot python3-certbot-nginx
#   sudo cp nginx.conf /etc/nginx/nginx.conf
#   # Edit server_name in nginx.conf to your domain
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your-domain.com
