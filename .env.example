# Copy to .env and replace CHANGE_ME before production. Do not commit .env.

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Number of uvicorn worker processes. 1 = single process (one GIL: a slow request
# blocks all others). More workers serve concurrent report viewers in parallel
# and isolate a slow request. Default 4 = one worker per core on the recommended
# 4 vCPU / 16 GB VM. Safe with the cross-process query coalescing AND the
# cross-worker snapshot-rebuild claim (both use the shared sqlite marker in
# /app/.data), which caps concurrent snapshot BUILDs to 1 — so extra workers no
# longer risk N parallel table-in-RAM builds OOM-ing the box. One caveat remains:
# a SINGLE build still holds its table in RAM, so watch memory if you materialize
# very large tables, and scale workers down (or the VM up) if so.
WEB_CONCURRENCY=4

# --- Database (use DATABASE_URL for managed PG, else DB_*) ---
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/appbi?sslmode=require
DATABASE_URL=
DB_HOST=appbi-db
DB_PORT=5432
DB_USER=appbi
DB_PASSWORD=CHANGE_ME
DB_NAME=appbi
# Per-worker SQLAlchemy pool. get_db holds a connection for the whole request
# (incl. the brief cold-burst coalescing wait), so 40/worker absorbs a realistic
# concurrent-view spike. Ceiling rule: (POOL_SIZE + MAX_OVERFLOW) × WEB_CONCURRENCY
# (+ the pdf-worker's pool) < Postgres max_connections. Defaults (20+20)×4 = 160
# + pdf ≈ 40 sit under the bundled local-db's max_connections=250. If you use a
# MANAGED Postgres, set its max_connections ≥ 250 (or lower these).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# --- Security ---
# SECRET_KEY:                python -c "import secrets; print(secrets.token_urlsafe(64))"
# DATASOURCE_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME
DATASOURCE_ENCRYPTION_KEY=
COOKIE_SECURE=true

# --- First admin ---
ADMIN_EMAIL=admin@appbi.io
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin

# --- URLs / ports ---
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Auth ---
AUTH_PASSWORD_LOGIN_ENABLED=true
NEXT_PUBLIC_AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_DATA_REDIRECT_URI=
AUTH_GOOGLE_ALLOWED_DOMAINS=
AUTH_GOOGLE_AUTO_CREATE_USERS=false
AUTH_GOOGLE_BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Feature flags ---
WORKBOARDS_ENABLED=true
NEXT_PUBLIC_WORKBOARDS_ENABLED=true
SEED_DEMO_DATA=false
# Home ("Trang chủ" / Overview) module. Off by default: the landing page read
# five list endpoints and joined them into a lineage graph, which made the first
# screen after login the slowest one in the app. Off = no sidebar row, `/` lands
# on Dashboards, and /overview redirects instead of loading. NEXT_PUBLIC_* is
# inlined at build time, so turning it back on requires rebuilding the frontend.
NEXT_PUBLIC_HOME_MODULE_ENABLED=false

# --- Modules (DB-backed; ON by default) ---
# `run` force-enables these (see scripts/bootstrap-env.sh); set here for manual deploys.
# METADATA_CATALOG_ENABLED gates the whole Intelligence sidebar group
#   (AI Readiness / AI Suggestions / Metrics & Terms / AI Guidance / Documents) + Observability.
# GOVERN_ENABLED is the permission key shared by every Intelligence module (view = review, edit = author).
# No extra env is needed for the Intelligence modules — the schema migrates automatically on boot.
METADATA_CATALOG_ENABLED=true
GOVERN_ENABLED=true
OBSERVABILITY_ENABLED=true

# --- Mini-app web push (workboards) — optional; generate with `web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:admin@example.com

# --- Query & cache limits ---
BQ_MAX_BYTES_SCANNED=64424509440
BQ_PREVIEW_PARTITION_MAX_LOOKBACK_DAYS=365
# ─── Snapshot materialization (Dashboard perf #5) ─────────────────────────────
# Pre-computes heavy dataset tables into flat BigQuery "snapshot" tables so
# dashboards load fast. OPT-IN per datasource (set materialization_enabled on the
# datasource). Data flow: the connected datasource account EXTRACTS source rows
# (read-only); the WRITE SERVICE ACCOUNT below CREATES + LOADS the snapshot tables
# (it never reads your source). Charts then read the snapshots via that same SA.
#
# 1) Snapshot dataset — a dedicated BQ dataset, created in the SAME project as the
#    datasource's source tables. Intended to be accessible ONLY by the write SA.
MATERIALIZATION_DATASET=appbi_snapshots
#
# 2) Write service account (AppBI-owned) — CREATES + LOADS snapshot tables. Grant
#    it "BigQuery Data Editor" on the snapshot dataset ONLY (it needs NO access to
#    your source data). Provide its key ONE of two ways (KEY_FILE takes priority):
#      • MATERIALIZATION_SA_KEY_FILE      = absolute path to the SA JSON key file
#      • MATERIALIZATION_SA_CREDENTIALS_JSON = the SA key JSON inline (single line)
#    Leave BOTH blank to fall back to the datasource's own credential (only works
#    if that credential can write the snapshot dataset — not the SA-isolation model).
MATERIALIZATION_SA_KEY_FILE=
MATERIALIZATION_SA_CREDENTIALS_JSON=
#
# 3) Default snapshot freshness TTL (minutes) — fallback for builder/public links.
MATERIALIZATION_DEFAULT_TTL_MINUTES=30
LIVE_QUERY_CACHE_TTL=300
LIVE_QUERY_CACHE_MAX_SIZE=256
LIVE_QUERY_SHARED_CACHE_ENABLED=true
LIVE_QUERY_SHARED_CACHE_DB_PATH=
LIVE_QUERY_SHARED_CACHE_MAX_SIZE=4096
LARGE_TABLE_ROW_THRESHOLD=50000000
LARGE_TABLE_SIZE_THRESHOLD_GB=5
# Rate limit for POST /integrations/embed/resolve, keyed by the caller's PAT
# (not IP) — a host app minting one scoped embed link per viewer from a single
# server isn't throttled as one IP. Cheap endpoint (DB only, no warehouse);
# generous by default, still blocks a runaway mint loop.
EMBED_RESOLVE_RATE_LIMIT=6000/minute

# --- Embed links (docs/embed-integration-api.md) ---
# Which sites may iframe an embed link is normally declared PER INTEGRATION:
# POST /integrations/embed/resolve accepts `allowed_origins` once and remembers it
# on the caller's personal access token (an operator can also set it via
# /auth/personal-access-tokens/admin/<id>/embed-origins). Nothing to configure
# here for that.
#
# The variable below is a deployment-wide FLOOR applied to /embed and /d pages
# regardless of what any integration declared — space-separated origins, e.g.
#   EMBED_FRAME_ANCESTORS=https://app.base.vn https://*.base.vn
# Empty = no floor (per-integration allowlists still apply). Read at runtime by
# the frontend, so changing it needs a container restart, not a rebuild.
EMBED_FRAME_ANCESTORS=

# --- Dashboard PDF export (docs/pdf-export.md) ---
# Delivery: Export shows progress on the report and downloads the file. Set the
# next flag to true to ALSO show the finished PDF in a second browser tab
# (the tab displays a blob: address, which most business readers find
# confusing — hence off by default). NEXT_PUBLIC_* is inlined at build time,
# so changing it requires rebuilding the frontend image.
NEXT_PUBLIC_PDF_PREVIEW_TAB=false

# Server-side render engine (optional). Renders in a headless-Chromium
# container instead of the viewer's browser: seconds instead of minutes,
# survives a closed tab, vector charts, and it is what scheduling/email will
# build on. Needs the extra service:
#   docker compose --profile pdf up -d --build pdf-worker
# Left false, exports still work — they just run in the browser as before.
PDF_EXPORT_ENABLED=false
# Where the worker container reaches the report frontend (container-to-container).
PDF_RENDER_BASE_URL=http://frontend:3000
# How long a rendered file stays downloadable before the retention pass deletes it.
PDF_FILE_TTL_HOURS=48
# Renders one shared link / one signed-in user may start per hour (429 above it).
PDF_QUOTA_PER_LINK_HOUR=20
PDF_QUOTA_PER_USER_HOUR=60
# Tuning — the defaults suit every deployment we have seen; uncomment to change.
# Seconds the worker waits for ONE dashboard page to report itself render-ready.
#PDF_RENDER_PAGE_TIMEOUT=120
# Hard ceiling for one whole export job.
#PDF_RENDER_JOB_TIMEOUT=900
# A running job whose heartbeat is older than this is treated as a dead worker
# and re-queued.
#PDF_JOB_LEASE_SECONDS=180
#PDF_JOB_MAX_ATTEMPTS=3

# --- SMTP (leave SMTP_HOST blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AppBI Quality
SMTP_TIMEOUT_SECONDS=20

# --- GCP service account ---
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_SERVICE_ACCOUNT_JSON=

# AI provider keys (backend AI + report AI bot).
OPENAI_API_KEY=
# Allowed per-document embedding models. All profiles emit the fixed 768
# dimensions used by the pgvector schema.
OPENAI_EMBEDDING_MODELS=text-embedding-3-small,text-embedding-3-large
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
